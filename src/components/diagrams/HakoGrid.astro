---
// ハコボットのグリッドとブロック配列の関係を、2次元に簡略化して3段階で示す図。
// グリッドには配置済みブロックのインデックス（空きは -1）だけを格納する。
import Arrow from '../Arrow.astro';

type Block = { base: string; rot: string; shape: [number, number][]; pivot: [number, number] };

const blocks: Block[] = [
  { base: '(1,2)', rot: '0°', shape: [[0, 1], [1, 0], [1, 1], [2, 0]], pivot: [1, 0] },
  { base: '(3,3)', rot: '90°', shape: [[0, 1], [1, 0], [1, 1], [1, 2]], pivot: [1, 1] },
];

// [行, 列] のセルと、そこに入るブロック番号
const placed: [number, number, number][][] = [
  [],
  [[1, 2, 0], [2, 1, 0], [2, 2, 0], [3, 1, 0]],
  [[2, 3, 1], [3, 2, 1], [3, 3, 1], [3, 4, 1]],
];

const steps = placed.map((_, s) => {
  const grid = Array.from({ length: 5 }, () => Array.from({ length: 5 }, () => ({ v: -1, isNew: false })));
  placed.slice(0, s + 1).forEach((cells, k) =>
    cells.forEach(([r, c, v]) => (grid[r][c] = { v, isNew: k === s })),
  );
  return { grid, blocks: blocks.slice(0, s) };
});
const label = ['初期状態', 'ブロック 0 を設置', 'ブロック 1 を設置'];
---

<figure class="hako">
  <div class="track">
    {
      steps.map((step, s) => (
        <>
          {s > 0 && <Arrow />}
          <div class="step">
            <span class="mono cap">{label[s]}</span>
            <div class="grid">
              {step.grid.flat().map((c) => (
                <span class:list={['cell', { set: c.v >= 0, new: c.isNew }]}>{c.v}</span>
              ))}
            </div>
            <table class="mono">
              <tbody>
                <tr>
                  <th>配列</th>
                  {step.blocks.map((_, i) => <td class:list={{ new: i === s - 1 }}>{i}</td>)}
                </tr>
                <tr>
                  <th>基準点</th>
                  {step.blocks.map((b) => <td>{b.base}</td>)}
                </tr>
                <tr>
                  <th>回転</th>
                  {step.blocks.map((b) => <td>{b.rot}</td>)}
                </tr>
                <tr>
                  <th>形状</th>
                  {step.blocks.map((b) => (
                    <td>
                      <span class="mini">
                        {Array.from({ length: 9 }, (_, k) => {
                          const r = Math.floor(k / 3), c = k % 3;
                          const on = b.shape.some(([y, x]) => y === r && x === c);
                          const pivot = b.pivot[0] === r && b.pivot[1] === c;
                          return <i class:list={{ on, pivot }} />;
                        })}
                      </span>
                    </td>
                  ))}
                </tr>
              </tbody>
            </table>
          </div>
        </>
      ))
    }
  </div>
  <figcaption class="mono">グリッドにはブロックのインデックスだけを格納（GridBlockData.cpp、DynamicDimensionalArray.h、Vec.h）</figcaption>
</figure>

<style>
  .hako {
    margin: 24px 0;
    border: var(--line);
    background: var(--bg);
  }
  .track {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .step {
    display: grid;
    gap: 6px;
    width: 140px;
  }
  .cap {
    font-size: 11px;
    text-transform: none;
    color: var(--muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border: var(--line);
    background: var(--paper);
  }
  .cell {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 24px;
    text-align: center;
    border: var(--hair);
    border-color: color-mix(in srgb, var(--ink) 20%, transparent);
    color: var(--muted);
  }
  .cell.set {
    color: var(--ink);
    font-weight: 700;
    font-size: 12px;
  }
  .cell.new {
    background: var(--accent);
    color: #fff;
  }
  table {
    border-collapse: collapse;
    font-size: 10px;
    background: var(--paper);
    border: var(--line);
    width: 100%;
    min-height: 92px;
  }
  th,
  td {
    border: var(--hair);
    padding: 2px 4px;
    text-align: center;
    font-weight: 500;
  }
  th {
    text-align: left;
    width: 40px;
    color: var(--muted);
  }
  td.new {
    background: var(--accent);
    color: #fff;
  }
  .mini {
    display: inline-grid;
    grid-template-columns: repeat(3, 8px);
    gap: 1px;
    vertical-align: middle;
  }
  .mini i {
    width: 8px;
    height: 8px;
  }
  .mini i.on {
    background: var(--ink);
  }
  .mini i.pivot {
    background: var(--accent);
  }
  figcaption {
    border-top: var(--line);
    padding: 6px 10px;
    text-transform: none;
  }
  @media (max-width: 640px) {
    .track {
      flex-direction: column;
    }
    .step {
      width: 200px;
    }
  }
</style>
