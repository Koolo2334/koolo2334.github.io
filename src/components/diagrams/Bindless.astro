---
import Arrow from '../Arrow.astro';

const tables = [
  { name: 'DescriptorTable 1', group: 'a', items: ['Albedo_1', 'Normal_1'] },
  { name: 'DescriptorTable 2', group: 'b', items: ['Albedo_2', 'Normal_2'] },
  { name: 'DescriptorTable 3', group: 'c', items: ['GBufferA', 'GBufferM', 'GBufferN', 'GBufferD'] },
];
const global = tables.flatMap((t) => t.items.map((name) => ({ name, group: t.group })));
---

<figure class="bindless">
  <div class="grid">
    <div class="side">
      <span class="mono label">Before：描画ごとにテーブルを切り替え</span>
      {
        tables.map((t) => (
          <div class="table">
            <div class="mono head">{t.name}</div>
            <ol>
              {t.items.map((it, i) => (
                <li class={t.group}>
                  <b>{i}</b>
                  {it}
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
    <Arrow />
    <div class="side">
      <span class="mono label">After：単一のテーブルをインデックスで参照</span>
      <div class="table">
        <div class="mono head">GlobalDescriptorTable</div>
        <ol class="two">
          {
            global.map((it, i) => (
              <li class={it.group}>
                <b>{i}</b>
                {it.name}
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</figure>

<style>
  .bindless {
    margin: 24px 0;
    border: var(--line);
    background: var(--bg);
    padding: 36px 16px 16px;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 12px;
    align-items: center;
  }
  .side {
    position: relative;
    display: grid;
    gap: 8px;
  }
  /* ラベルは表の外に出し、表と矢印の中心を揃える */
  .label {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 0;
    text-transform: none;
    color: var(--muted);
  }
  .table {
    border: var(--line);
    background: var(--paper);
  }
  .head {
    background: var(--ink);
    color: var(--bg);
    padding: 2px 8px;
    text-transform: none;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 6px;
    display: grid;
    gap: 4px;
  }
  ol.two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: column;
    grid-template-rows: repeat(4, auto);
  }
  li {
    display: flex;
    font-family: var(--font-mono);
    font-size: 12px;
    border: var(--hair);
  }
  li b {
    width: 22px;
    text-align: center;
    border-right: var(--hair);
    font-weight: 500;
  }
  li {
    gap: 6px;
    padding-right: 6px;
  }
  .a {
    background: var(--accent);
    color: #fff;
  }
  .b {
    background: var(--ink);
    color: var(--bg);
  }
  .b b {
    border-right-color: var(--bg);
  }
  .c {
    background: var(--paper);
  }
  @media (max-width: 640px) {
    .bindless {
      padding-top: 16px;
    }
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .label {
      position: static;
    }
  }
</style>
