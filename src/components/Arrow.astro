---
// 図解の列と列をつなぐ横向きの矢印。ラベルは矢印の上に置き、矢印自体の位置には影響させない。
// 狭い幅では下向きになり、ラベルは横に並ぶ。
interface Props {
  label?: string;
}

const { label } = Astro.props;
---

<div class:list={['arrow', { bare: !label }]}>
  {label && <span class="mono label">{label}</span>}
  <svg width="40" height="12" viewBox="0 0 40 12" aria-hidden="true">
    <line x1="0" y1="6" x2="30" y2="6" />
    <polygon points="40,6 30,1 30,11" />
  </svg>
</div>

<style>
  .arrow {
    position: relative;
    flex: 0 0 auto;
    width: 92px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  /* ラベルがなければ幅を詰める */
  .arrow.bare {
    width: 56px;
  }
  svg {
    display: block;
  }
  line {
    stroke: var(--ink);
    stroke-width: 2;
  }
  polygon {
    fill: var(--ink);
  }
  .label {
    position: absolute;
    bottom: calc(50% + 10px);
    left: 0;
    right: 0;
    font-size: 11px;
    line-height: 1.3;
    text-align: center;
    text-transform: none;
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .arrow,
    .arrow.bare {
      width: auto;
      height: 52px;
    }
    svg {
      transform: rotate(90deg);
    }
    .label {
      bottom: auto;
      top: 50%;
      left: calc(50% + 16px);
      right: auto;
      transform: translateY(-50%);
      white-space: nowrap;
      text-align: left;
    }
  }
</style>
