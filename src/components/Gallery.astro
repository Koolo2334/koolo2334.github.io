---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  items: { src: ImageMetadata; caption: string }[];
  cols?: number;
}

const { items, cols = 2 } = Astro.props;
---

<div class="gallery" style={`--cols:${cols}`}>
  {
    items.map((it) => (
      <figure>
        <Image src={it.src} alt={it.caption} widths={[400, 800]} sizes="(max-width: 700px) 50vw, 400px" />
        <figcaption class="mono">{it.caption}</figcaption>
      </figure>
    ))
  }
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    border-top: var(--line);
    border-left: var(--line);
    margin: 32px 0;
  }
  figure {
    margin: 0;
    border-right: var(--line);
    border-bottom: var(--line);
    display: flex;
    flex-direction: column;
  }
  figure :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--ink);
  }
  figcaption {
    border-top: var(--line);
    padding: 4px 8px;
    text-transform: none;
  }
  @media (max-width: 560px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
