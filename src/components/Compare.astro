---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Side {
  src: ImageMetadata;
  label: string;
}

interface Props {
  a: Side;
  b: Side;
  caption?: string;
}

const { a, b, caption } = Astro.props;
---

<figure class="cmp">
  <div class="pair">
    {
      [a, b].map((s) => (
        <div class="side">
          <Image src={s.src} alt={s.label} widths={[480, 960]} sizes="(max-width: 700px) 100vw, 550px" />
          <span class="mono label">{s.label}</span>
        </div>
      ))
    }
  </div>
  {caption && <figcaption class="mono">{caption}</figcaption>}
</figure>

<style>
  .cmp {
    margin: 32px 0;
    border: var(--line);
  }
  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .side {
    position: relative;
    background: var(--ink);
  }
  .side + .side {
    border-left: var(--line);
  }
  .side :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .label {
    position: absolute;
    left: 0;
    top: 0;
    background: var(--bg);
    border-right: var(--line);
    border-bottom: var(--line);
    padding: 2px 8px;
    text-transform: none;
  }
  .side + .side .label {
    background: var(--accent);
    color: #fff;
  }
  figcaption {
    border-top: var(--line);
    padding: 6px 10px;
    text-transform: none;
  }
  @media (max-width: 560px) {
    .pair {
      grid-template-columns: minmax(0, 1fr);
    }
    .side + .side {
      border-left: 0;
      border-top: var(--line);
    }
  }
</style>
