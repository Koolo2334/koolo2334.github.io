---
import '../styles/global.css';
import { profile } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = `${profile.nameEn} — ${profile.role}` } = Astro.props;
const pageTitle = title ? `${title} — ${profile.nameEn}` : `${profile.nameEn} Portfolio`;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Noto+Sans+JP:wght@400;700&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header wrap">
      <a href={base} class="mono home">{profile.nameEn}</a>
      <nav class="mono">
        <a href={`${base}#works`}>Works</a>
        <a href={`${base}#about`}>About</a>
        <a href={profile.github} target="_blank" rel="noopener">GitHub↗</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer wrap">
      <span class="mono">© 2026 {profile.nameEn}</span>
      <a class="mono" href="#">Top↑</a>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 48px;
    background: var(--bg);
    border-bottom: var(--line);
  }
  .site-header a {
    text-decoration: none;
  }
  .home {
    font-weight: 500;
  }
  nav {
    display: flex;
    gap: clamp(12px, 3vw, 32px);
  }
  nav a:hover,
  .home:hover {
    color: var(--accent);
  }
  .site-footer {
    display: flex;
    justify-content: space-between;
    border-top: var(--line);
    padding-block: 14px;
    margin-top: 96px;
  }
  .site-footer a {
    text-decoration: none;
  }
</style>
